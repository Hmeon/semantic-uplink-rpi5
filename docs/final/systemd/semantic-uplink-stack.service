[Unit]
Description=Semantic Uplink (edge + collector + broker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/semantic-uplink-rpi5
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 -m stack.pi_stack \
  --run-dir /var/lib/semantic-uplink/run \
  --device-config configs/device.yaml \
  --policy-arms configs/policy.yaml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
