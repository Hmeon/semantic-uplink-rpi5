[Unit]
Description=Semantic Uplink (edge + collector + broker)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/semantic-uplink-rpi5
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/semantic-uplink-stack.env
ExecStart=/home/pi/semantic-uplink-rpi5/scripts/run_stack.sh
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target

