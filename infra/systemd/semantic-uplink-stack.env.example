# Optional overrides for semantic-uplink-stack.service (loaded from /etc/semantic-uplink-stack.env)

# Shared run directory (collector writes parquet logs; edge stores outbox.sqlite).
RUN_DIR=artifacts/live

# Config paths (relative to repo root when using scripts/run_stack.sh).
DEVICE_CONFIG=configs/device.yaml
POLICY_ARMS=configs/policy.yaml

# Broker connection & startup behavior.
BROKER_HOST=localhost
BROKER_PORT=1883
BROKER_MODE=auto            # auto | subprocess | none
MOSQUITTO_BIN=mosquitto
MOSQUITTO_LISTEN_HOST=127.0.0.1

# Collector tuning.
COLLECTOR_FLUSH_INTERVAL_S=10

# Hardware buttons / tc shaping.
BUTTONS_ENABLE=1
TC_ENABLE=1
TC_IFACE=lo
TC_BOTH=0
TC_PROFILES_CONFIG=configs/link_profiles.yaml

